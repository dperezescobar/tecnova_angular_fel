{
  "name": "tecnova-erp",
  "version": "1.4.2",
  "eurosoccerVersion": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "eurosoccer:start": "ng serve eurosoccer-app --port 4300",
    "eurosoccer:build": "ng build eurosoccer-app",
    "preeurosoccer:build": "node scripts/sync-version-eurosoccer.js",
    "prebuild": "node scripts/sync-version.js",
